# Pinterest API 설정
# https://developers.pinterest.com/console 에서 발급받은 정보를 입력하세요

PINTEREST_CLIENT_ID=your_client_id_here
PINTEREST_CLIENT_SECRET=your_client_secret_here
PINTEREST_REDIRECT_URI=http://localhost:3000/auth/callback

# 포트 설정
PORT=3000
NODE_ENV=development

# 또는 Access Token이 있다면 직접 입력 (권장)
PINTEREST_ACCESS_TOKEN=your_access_token_here
